        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 版 NekoTrans"
          }
        }
      }
    },
    "NekoTrans chạy ngầm êm ái trên thanh Menu. Khi đóng cửa sổ, bạn vẫn có thể bấm vào icon 🐱 hoặc nhấn phím tắt ⌥D để tra cứu bất cứ lúc nào." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NekoTrans runs silently in the Menu Bar. When windows close, click the 🐱 icon or press ⌥D anytime to look up."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NekoTrans chạy ngầm êm ái trên thanh Menu. Khi đóng cửa sổ, bạn vẫn có thể bấm vào icon 🐱 hoặc nhấn phím tắt ⌥D để tra cứu bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NekoTrans 在菜单栏静默运行。关闭窗口后，您仍可随时点击 🐱 图标或按下 ⌥D 快捷键进行查词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NekoTrans 在選單列靜默執行。關閉視窗後，您仍可隨時點擊 🐱 圖示或按下 ⌥D 快速鍵進行查詞。"
          }
        }
      }
    },
    "NekoTrans cần quyền Trợ năng để tự động trích xuất văn bản khi bạn bôi đen và nhấn phím tắt." : {
