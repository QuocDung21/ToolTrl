        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NekoTrans 及其所有关联数据（词汇本、设置、钥匙串中的 API 密钥和缓存）将从此 Mac 中永久删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
